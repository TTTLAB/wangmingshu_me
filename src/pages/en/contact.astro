---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactPage from '../../components/ContactPage.astro';
import { contactContent } from '../../data/contact';

const c = contactContent.en;
---
<BaseLayout
  lang="en"
  title={c.meta.title}
  description={c.meta.description}
  alternate="/contact"
  navbarDark
  footerTheme="light"
  page="contact"
>
  <ContactPage lang="en" />
</BaseLayout>
