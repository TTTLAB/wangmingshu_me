---
import LoaderLogo from './svg/LoaderLogo.astro';
---
<div class="loader" data-loader style="position:fixed;inset:0;z-index:var(--z-loader)" transition:persist>
  <div class="loader__bg" style="position:absolute;inset:0;background-color:var(--color-dark-black)" aria-hidden="true"></div>
  <p class="loader__label loader__label--top js-loader-label-top">鼠王 RatKing</p>
  <p class="loader__label loader__label--bottom js-loader-label-bottom">鼠鼠我啊，又活过一天捏。</p>
  <div class="loader__dot loader__dot--tl js-loader-dot" aria-hidden="true"></div>
  <div class="loader__dot loader__dot--tr js-loader-dot" aria-hidden="true"></div>
  <div class="loader__dot loader__dot--bl js-loader-dot" aria-hidden="true"></div>
  <div class="loader__dot loader__dot--br js-loader-dot" aria-hidden="true"></div>
  <div class="loader__wrapper">
    <div class="loader__logo">
      <LoaderLogo />
    </div>
  </div>
</div>
