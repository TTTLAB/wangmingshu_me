---
import { homeContent } from '../../data/home';
import { routes, type Lang } from '../../data/site';
import Button from '../Button.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = homeContent[lang];
const contactHref = routes[lang].contact;
---
<section class="data-viz-section">
  <div class="data-viz-section__container">
    <div class="data-viz-section__canvas">
      <div class="data-viz-section__canvas-veil"></div>
      <div style="position:relative;width:100%;height:100%;overflow:hidden;pointer-events:auto" class="custom-canvas" data-dataviz-canvas>
        <div style="width:100%;height:100%">
          <canvas style="display:block" aria-hidden="true"></canvas>
        </div>
      </div>
    </div>
    <div class="data-viz-section__bottom">
      <p class="t-lg data-viz-section__title">{c.dataVizText}</p>
    </div>
    <div class="data-viz-section__center">
      <p class="t-2lg data-viz-section__center-title" set:html={c.dataVizCenterTitle}></p>
      <p class="t-md data-viz-section__center-text">{c.dataVizCenterText}</p>
      <Button href={contactHref} label={c.dataVizCta} className="data-viz-section__center-button" />
    </div>
  </div>
</section>
