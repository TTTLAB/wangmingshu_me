---
/**
 * Renders a plain-text string, honouring only literal `<br>` / `<br/>` as a
 * line break. Everything else stays text, so no other markup can be injected.
 */
interface Props {
  text: string;
}
const { text } = Astro.props;
const parts = String(text ?? '').split(/<br\s*\/?>/i);
---
{parts.map((part, i) => (
  <Fragment>
    {i > 0 && <br />}
    {part}
  </Fragment>
))}
